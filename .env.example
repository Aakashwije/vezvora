# Admin authentication (generate a scrypt hash with the command in README.md)
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Durable admin/contact/quotation storage. Use either pair; Vercel's Upstash
# integration commonly injects the KV_REST_API_* names automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional notification and analytics integrations
CONTACT_WEBHOOK_URL=
NEXT_PUBLIC_PLAUSIBLE_ENABLED=false
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# ---------------------------------------------------------------------------
# Instant Estimate quotations
# ---------------------------------------------------------------------------

# Email delivery (Resend). Without a key the app logs what it would have sent
# instead of failing, so local development works with no provider account.
RESEND_API_KEY=
# Must be a verified sender on your Resend domain.
QUOTATION_FROM_EMAIL="Vezvora <quotations@vezvora.io>"
QUOTATION_REPLY_TO=vezvoraa@gmail.com
# Where the "new estimate request" notification is sent.
QUOTATION_ADMIN_EMAIL=vezvoraa@gmail.com

# Minutes administrators get to review before the estimate auto-sends (1-1440).
QUOTATION_REVIEW_MINUTES=10

# Public submissions allowed per IP address (defaults: 5 per 15 minutes).
# QUOTATION_RATE_LIMIT_MAX=5
# QUOTATION_RATE_LIMIT_WINDOW_SECONDS=900

# Required for the precise 10-minute auto-send on Vercel Hobby. The daily
# Vercel Cron job is only a safety sweep and may send overdue quotations later.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Shared secret for the cron sweeper. Vercel injects CRON_SECRET automatically
# for scheduled invocations; set QUOTATION_CRON_SECRET to override it.
# CRON_SECRET=
# QUOTATION_CRON_SECRET=

# Absolute origin used for job callbacks and admin links inside emails.
# Derived from Vercel's own env vars in production; set it for other hosts.
# QUOTATION_APP_URL=https://vezvora.io

# PDF safe-area margins in points, if the letterhead artwork changes.
# QUOTATION_PDF_MARGIN_TOP=155
# QUOTATION_PDF_MARGIN_BOTTOM=130
# QUOTATION_PDF_MARGIN_LEFT=56
# QUOTATION_PDF_MARGIN_RIGHT=56
