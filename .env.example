# Admin authentication (generate a scrypt hash with the command in README.md)
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Durable admin/contact storage. Use either pair; Vercel's Upstash integration
# commonly injects the KV_REST_API_* names automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional notification and analytics integrations
CONTACT_WEBHOOK_URL=
NEXT_PUBLIC_PLAUSIBLE_ENABLED=false
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io
